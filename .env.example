NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/togsogch
REDIS_URL=
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4100/api/v1/auth/google/callback
SUPER_ADMIN_EMAILS=
DEV_LOGIN_ENABLED=false
# QPay v2 (GoAylal-тай ижил) - зөвхөн backend. Production-д дөрвөн утга заавал.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# QPay payment/check-г давтан дуудахыг хориглодог. Анхдагч 0 = 3 сек poll QPay-аас асуухгүй; төлбөр callback-аар эсвэл
# төлөгчийн «Төлбөр шалгах» товчоор баталгаажина. Эерэг тоо = callback ирээгүй үед тэр хугацаанд нэг л удаа асуух аюулгүйн тор.
# QPAY_STATUS_CHECK_INTERVAL_S=0

PAYMENT_PROVIDER=qpay
PUBLIC_API_URL=http://localhost:4100   # production-д https (QPay callback-ийн нийтийн хаяг)
# GoAylal-тай ижил нэр (заавал биш): QPAY_CALLBACK_URL=https://api.example.mn/api/v1/payments/qpay/callback (байвал PUBLIC_API_URL-аас давуу); CORS_ORIGIN нь FRONTEND_URL-ийн alias

# Phase 4 (optional): AI тайлбар. Түлхүүргүй бол баталгаатай өгөгдлөөс шаблон тайлбар гарна.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Reverse proxy (Cloudflare/Render)-ийн ард ажиллавал 1 гэж тохируулна (жинхэнэ IP-тэй rate limit)
TRUST_PROXY=
SWAGGER_ENABLED=false
